# ============================================================================
# Android Remote Control v1.0 — VARIABLES D'ENVIRONNEMENT DE PRODUCTION (VPS)
# Installation : cp deploy/env.vps.example .env  (à la racine du projet)
# Puis REMPLIR chaque secret. Le fichier .env est gitigné — JAMAIS commité.
# ============================================================================

# ——— Mode d'exécution (OBLIGATOIRE) ———
# "production" : aucune donnée fabriquée ; simulateur désactivé ; sessions et
# commandes réelles refusées (503) tant que l'agent Android + RustDesk ne sont
# pas connectés.
ARC_MODE=production

# ——— Secret de signature des cookies de session (OBLIGATOIRE) ———
# Générer : openssl rand -base64 48
# Le serveur REFUSE de démarrer sans lui (>= 32 caractères).
ARC_SESSION_SECRET=

# ——— Cookie Secure (déjà actif par défaut en mode production) ———
ARC_COOKIE_SECURE=true

# ——— PostgreSQL (OBLIGATOIRE) ———
# Générer : openssl rand -base64 24
POSTGRES_PASSWORD=
# (le reste de l'URL est construit par docker-compose.vps.yml : utilisateur "arc",
#  base "android_remote_control", hôte "db" sur le réseau interne arc-app-db)

# ——— Bootstrap du premier administrateur (ONE-SHOT) ———
# Requis uniquement pour : docker compose -f docker-compose.vps.yml run --rm console bun prisma/bootstrap-admin.ts
# Identifiant : 3–64 caractères [a-zA-Z0-9._-]
ARC_ADMIN_USERNAME=
# Mot de passe >= 12 caractères ; LAISSER VIDE pour qu'un mot de passe fort soit
# GÉNÉRÉ et affiché une seule fois à l'exécution.
ARC_ADMIN_PASSWORD=
# Retirer ces deux variables du fichier après le bootstrap, puis :
#   docker compose -f docker-compose.vps.yml restart console

# ——— RustDesk (étape 5) ———
# HÔTE PUBLIC DIRECT annoncé aux clients pour le relais (le port :21117 est ajouté
# par le compose). Utiliser l'IP du VPS ou un sous-domaine DNS-only (grey cloud).
# JAMAIS un domaine proxifié Cloudflare : les ports 2111x et l'UDP ne passent pas.
ARC_RELAY_ADDR=

# ——— Notes ———
# • DATABASE_URL est injectée par docker-compose.vps.yml (ne pas la définir ici).
# • Journalisation : NODE_ENV=production fixé par le compose ; logs Prisma réduits aux erreurs.
# • Aucun identifiant de démonstration n'existe en production : le seed refuse de s'exécuter.
